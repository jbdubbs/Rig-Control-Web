{
  "name": "rigcontrol-web",
  "private": true,
  "version": "1.2.0",
  "license": "Apache-2.0",
  "author": "Jason Weisberger NT0Y",
  "description": "A web-based frontend for hamlib rigctld for local installation and portable backend capabilities.",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "test:e2e": "node tests/e2e/reset-test-data.mjs && playwright test",
    "test:e2e:ui": "node tests/e2e/reset-test-data.mjs && playwright test --ui",
    "test:hardware": "node tests/e2e-hardware/reset-test-data.mjs && playwright test --config=playwright.hardware.config.ts",
    "electron:dev": "ELECTRON_RUN=true electron -r tsx electron/main.ts",
    "electron:build": "node scripts/build-rigctld.mjs && npm run build && npm run build:electron && electron-builder",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.cjs --external:electron --external:vite && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron",
    "build:cw-helper": "node scripts/build-cw-helper.mjs",
    "build:ft4222-reader": "node scripts/build-ft4222-reader.mjs",
    "build:wsjtx-bridge": "node scripts/build-wsjtx-bridge.mjs",
    "build:rigctld": "node scripts/build-rigctld.mjs",
    "build:rigctld-win-cross": "node scripts/build-rigctld-win-cross.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.rigcontrol.web",
    "productName": "RIGCONTROL WEB",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "radios.json",
      "assets/icons/**/*"
    ],
    "asarUnpack": [
      "bin/**/*",
      "**/*.node",
      "**/node_modules/libopus-node/**/*.wasm"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icons/rcw.ico",
      "uninstallerIcon": "assets/icons/rcw.ico",
      "include": "buildResources/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/rcw.ico",
      "files": [
        "bin/windows/**/*"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "rigcontrol-web",
      "maintainer": "Jason Weisberger <jason@weisb.net>",
      "icon": "assets/icons/rcw_512x512.png",
      "category": "Network;HamRadio;",
      "files": [
        "bin/linux/**/*"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "libpulse0",
        "libusb-1.0-0",
        "libreadline8",
        "libportaudio2"
      ],
      "recommends": [
        "libappindicator3-1"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib",
        "pulseaudio-libs",
        "libusb1",
        "readline",
        "portaudio"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/rcw.icns",
      "files": [
        "bin/mac/**/*"
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "libopus-node": "^0.0.4",
    "lucide-react": "^0.546.0",
    "naudiodon": "github:jbdubbs/naudiodon-gcc15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.8.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}
